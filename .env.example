# Server-only keys. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GITHUB_TOKEN=

# Personal access gate. Required in production (next start / Vercel); optional in local dev.
# Type the same value into the "Access code" box in the app once per browser.
JARVIS_ACCESS_CODE=

# Optional Live features (off by default; they need the v1beta API and have not been tested yet). Set to 1 to try.
JARVIS_AFFECTIVE_DIALOG=
JARVIS_PROACTIVE_AUDIO=

# Optional: repo used by the "Check repo status" button, as owner/name.
NEXT_PUBLIC_JARVIS_REPO=
